# Sao chép thành .env rồi chỉnh lại
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]

# Qdrant (docker compose up -d)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=danh_gia

# Embedding BGE-M3 (dense vector 1024 chiều)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# SQL Server – ReviewIntelligenceDB (chỉ đọc/ghi các bảng đã có trong schema)
SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=ReviewIntelligenceDB;UID=sa;PWD=DOI_MAT_KHAU_O_DAY;TrustServerCertificate=yes
