# Sao chép thành .env rồi chỉnh lại
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]

# SQL Server – ReviewIntelligenceDB (cần "ODBC Driver 18 for SQL Server")
SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=ReviewIntelligenceDB;UID=sa;PWD=DOI_MAT_KHAU_O_DAY;TrustServerCertificate=yes

# Qdrant: "local" = nhúng trong tiến trình, lưu ở QDRANT_PATH (không cần Docker)
#         "server" = docker compose up -d rồi dùng QDRANT_URL
QDRANT_MODE=local
QDRANT_PATH=./qdrant_local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=danh_gia

# Embedding: bge-m3 (khuyến nghị, cần sentence-transformers + torch) | hash (dự phòng)
EMBEDDING_BACKEND=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3

# Mô hình ABSA
PHOBERT_MODEL=wonrax/phobert-base-vietnamese-sentiment
DEVICE=auto
# auto = LLM_ItVD nếu có khóa Claude API, ngược lại PhoBERT | PhoBERT | LLM_KhongVD | LLM_ItVD
MO_HINH_PHAN_TICH=auto

# Claude API (LLM zero-shot / few-shot + sinh câu trả lời RAG). Để trống nếu chưa có.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT_PHAN_TICH=low
LLM_EFFORT_TRA_LOI=medium

# RAG
RAG_TOP_K=6
RAG_NGUONG_BGE=0.45
RAG_NGUONG_HASH=0.12
