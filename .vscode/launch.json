{
  // Cấu hình DEBUG (F5). Để chỉ chạy dịch vụ không cần debug, dùng task "Chạy tất cả dịch vụ" trong tasks.json.
  // Cần extension: Python Debugger (ms-python.debugpy), C# (ms-dotnettools.csharp) – xem extensions.json.
  // ⚠ ai-service: chỉ 1 tiến trình cùng lúc (Qdrant nhúng khóa ai-service/qdrant_local) – không vừa chạy task
  //   "AI Service (8000)" vừa debug "AI Service (debug)".
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AI Service (debug)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/ai-service/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/ai-service",
      "env": { "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8" },
      "preLaunchTask": "Kiểm tra: ai-service chưa chạy",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend API (debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: backend",
      "program": "${workspaceFolder}/backend/ReviewIntelligence.Api/bin/Debug/net8.0/ReviewIntelligence.Api.dll",
      "cwd": "${workspaceFolder}/backend/ReviewIntelligence.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Frontend Web (5173)"
    }
  ],
  "compounds": [
    {
      "name": "Debug toàn bộ (AI + Backend + Chrome)",
      "configurations": ["AI Service (debug)", "Backend API (debug)", "Frontend (Chrome)"],
      "stopAll": true
    }
  ]
}
